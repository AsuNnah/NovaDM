{
  "manifest_version": 3,
  "name": "NovaDM",
  "version": "0.7.0",
  "description": "Send downloads, videos and links from this browser to the NovaDM download manager.",
  "permissions": ["contextMenus", "downloads", "cookies", "storage", "webRequest", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "NovaDM", "default_popup": "popup.html", "default_icon": { "128": "icon.png" } },
  "options_page": "options.html",
  "icons": { "128": "icon.png" }
}
